{
  "name": "@abschluss/multiple-choice-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "lint": "eslint src test eslint.config.js",
    "lint:fix": "eslint src test eslint.config.js --fix"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.11.2",
    "mysql2": "^3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "tsx": "^4.23.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
