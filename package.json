{
  "name": "abschluss-multiple-choice-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @abschluss/multiple-choice-frontend --",
    "dev:backend": "npm run dev --workspace @abschluss/multiple-choice-backend",
    "dev:full": "npm run build:frontend && concurrently --kill-others-on-fail --names frontend,backend \"npm run build:watch --workspace @abschluss/multiple-choice-frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace @abschluss/multiple-choice-frontend",
    "build:backend": "npm run build --workspace @abschluss/multiple-choice-backend",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @abschluss/multiple-choice-frontend --",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
